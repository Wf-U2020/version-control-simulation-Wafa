from random import randrange

def display_board(board):
    print("+-------+-------+-------+")
    for row in board:
        print("|       |       |       |")
        print("|   {}   |   {}   |   {}   |".format(row[0], row[1], row[2]))
        print("|       |       |       |")
        print("+-------+-------+-------+")


def enter_move(board):
    while True:
        move = int(input("Enter your move (1-9): "))

        if move < 1 or move > 9:
            print("Move must be between 1 and 9.")
            continue

        row = (move - 1) // 3
        col = (move - 1) % 3

        if board[row][col] not in ['X', 'O']:
            board[row][col] = 'O'
            break
        else:
            print("Square already occupied. Try again.")


def make_list_of_free_fields(board):
    free = []

    for row in range(3):
        for col in range(3):
            if board[row][col] not in ['X', 'O']:
                free.append((row, col))

    return free


def victory_for(board, sign):
    # Check rows
    for row in board:
        if all(cell == sign for cell in row):
            return True

    # Check columns
    for col in range(3):
        if all(board[row][col] == sign for row in range(3)):
            return True

    # Check diagonals
    if all(board[i][i] == sign for i in range(3)):
        return True

    if all(board[i][2 - i] == sign for i in range(3)):
        return True

    return False


def draw_move(board):
    free = make_list_of_free_fields(board)

    if free:
        row, col = free[randrange(len(free))]
        board[row][col] = 'X'


# Main program
board = [
    [1, 2, 3],
    [4, 'X', 6],
    [7, 8, 9]
]

while True:
    display_board(board)

    enter_move(board)

    if victory_for(board, 'O'):
        display_board(board)
        print("You won!")
        break

    free = make_list_of_free_fields(board)
    if not free:
        display_board(board)
        print("Tie!")
        break

    draw_move(board)

    if victory_for(board, 'X'):
        display_board(board)
        print("Computer won!")
        break

    free = make_list_of_free_fields(board)
    if not free:
        display_board(board)
        print("Tie!")
        break